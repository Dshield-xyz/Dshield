{
  "name": "@dshield/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Merkle tree reconstruction and Stellar RPC scanning logic for the DShield frontend, CLI, and standalone indexer service.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./notes": {
      "types": "./dist/notes.d.ts",
      "default": "./dist/notes.js"
    },
    "./poseidon2": {
      "types": "./dist/poseidon2.d.ts",
      "default": "./dist/poseidon2.js"
    },
    "./prover": {
      "types": "./dist/prover.d.ts",
      "default": "./dist/prover.js"
    },
    "./prover-core": {
      "types": "./dist/prover-core.d.ts",
      "default": "./dist/prover-core.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@aztec/bb.js": "0.87.0",
    "@noir-lang/noir_js": "1.0.0-beta.9",
    "@stellar/stellar-sdk": "^16.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
