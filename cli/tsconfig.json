{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@dshield/core": ["../packages/core/src/index.ts"],
      "@dshield/core/*": ["../packages/core/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
