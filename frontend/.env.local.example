# Copy this file to frontend/.env.local and fill in real values.
#
# `just deploy` (and `just deploy testnet`) auto-writes a populated
# frontend/.env.local from the deployed contracts and funded accounts, so for
# the standard local-dev flow you do not need to set anything by hand. The
# values below are placeholders only — never commit real keys or secrets.
#
# If you are pointing the frontend at an existing deployment instead of running
# `just deploy`, set the public NEXT_PUBLIC_* values to match that deployment
# and set the server-only secrets only if you intend to use the faucet,
# relayer, and KYC-registration API routes.

# --- Public variables (shipped to the browser bundle) ---

# Soroban RPC endpoint used by the app.
NEXT_PUBLIC_RPC_URL=http://localhost:8000/soroban/rpc

# Stellar network passphrase for transaction signing and simulation.
NEXT_PUBLIC_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# (Optional) Secret key for a funded dev wallet. `just deploy` fills this with
# alice's key on local networks and leaves it blank on testnet; leave it blank
# to require users to connect via Freighter instead of auto-connecting.
NEXT_PUBLIC_DEV_SECRET_KEY=S...REPLACE_ME

# Human-readable code for the test USDC asset.
NEXT_PUBLIC_USDC_CODE=USDC

# Issuer public key of the test USDC asset.
NEXT_PUBLIC_USDC_ISSUER=G...REPLACE_ME

# Contract ID of the default shielded pool tier used by the UI.
NEXT_PUBLIC_POOL_CONTRACT_ID=C...REPLACE_ME

# Comma-separated tier list in the form "label:contractId:depositAmountStroops".
NEXT_PUBLIC_POOL_TIERS=10 USDC:C...REPLACE_ME:100000000,100 USDC:C...REPLACE_ME:1000000000,1000 USDC:C...REPLACE_ME:10000000000

# Contract ID of the compliance registry/verifier.
NEXT_PUBLIC_COMPLIANCE_CONTRACT_ID=C...REPLACE_ME

# --- Server-only variables (never exposed to the browser) ---

# Secret key of the USDC issuer account; used server-side by /api/faucet.
USDC_ISSUER_SECRET=S...REPLACE_ME

# Secret key of the relayer account that submits withdrawals on users' behalf.
RELAYER_SECRET=S...REPLACE_ME

# Secret key of the compliance admin account that registers KYC hashes.
COMPLIANCE_ADMIN_SECRET=S...REPLACE_ME

# Shared secret required in the x-admin-key header for /api/register-kyc.
KYC_ADMIN_API_KEY=REPLACE_ME
