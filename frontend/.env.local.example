# Secret seed key for the local USDC Faucet issuer account (Keep secure)
USDC_ISSUER_SECRET=""

# Endpoint URL for the Soroban RPC provider (e.g., http://localhost:8000/soroban/rpc)
NEXT_PUBLIC_RPC_URL="http://localhost:8000/soroban/rpc"

# The unique passphrase string identifying the target Stellar network configuration
NEXT_PUBLIC_NETWORK_PASSPHRASE="Standalone Network ; February 2017"

# The alphanumeric asset code representing the platform token (Defaults to USDC)
NEXT_PUBLIC_USDC_CODE="USDC"

# Stellar public key identifying the issuing account of the target USDC asset
NEXT_PUBLIC_USDC_ISSUER=""

# Secret seed key authorized to modify compliance settings on the platform
COMPLIANCE_ADMIN_SECRET=""

# Secure API authorization key required to interact with the backend KYC provider
KYC_ADMIN_API_KEY=""

# The unique Stellar/Soroban contract address hash for the compliance tracking module
NEXT_PUBLIC_COMPLIANCE_CONTRACT_ID=""

# Secret seed key used by the automated system relayer to clear user withdrawals
RELAYER_SECRET=""

# The unique Stellar/Soroban contract address hash for the shielded transaction pool
NEXT_PUBLIC_POOL_CONTRACT_ID=""

# Development secret seed key reserved strictly for local environment simulation
NEXT_PUBLIC_DEV_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Fee abstraction (issue #149) — withdrawals never require the caller to hold XLM
# ---------------------------------------------------------------------------
# Leave all three blank to disable: withdrawals behave exactly as before,
# with no fee carved out. All three must be set together for fee abstraction
# to take effect (the pool contract also needs a matching admin-configured
# set_dex_router call — see docs/THREAT_MODEL.md's "Fee abstraction" section).

# The native XLM Stellar Asset Contract id on the target network.
NEXT_PUBLIC_XLM_SAC_ID=""

# A Soroswap-compatible router contract id used to quote and swap the
# relayer's fee into XLM at withdrawal time.
NEXT_PUBLIC_DEX_ROUTER_ID=""

# Flat relayer fee, in the withdrawn asset's stroops, carved out of each
# relayed withdrawal and swapped for XLM. "0" (default) disables fee
# abstraction even if the router/XLM SAC above are set.
RELAYER_FEE_STROOPS="0"

# ---------------------------------------------------------------------------
# Upstash Redis — durable, cross-instance rate limiting
# ---------------------------------------------------------------------------
# Create a free database at https://upstash.com/ and copy the REST credentials.
# Without these, the rate limiter falls back to a per-process in-memory store
# that resets on every redeploy and provides no protection across serverless
# instances. Leave blank for local development (fallback is fine for a single
# process), but set both before deploying to a multi-instance environment.
#
# Find these values in the Upstash Console → your database → "REST API".
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
