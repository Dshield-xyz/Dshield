{
  "circuit": "shielded_pool",
  "source_path": "circuits/shielded_pool/src/main.nr",
  "artifact_candidates": [
    "circuits/shielded_pool/target/shielded_pool.json",
    "frontend/src/circuits/shielded_pool.json"
  ],
  "abi": {
    "public": [
      "root",
      "nullifier_hash",
      "recipient",
      "withdraw_amount",
      "change_commitment",
      "asset"
    ],
    "private": [
      "nullifier",
      "secret",
      "amount",
      "change_nullifier",
      "change_secret",
      "path_siblings",
      "path_bits"
    ],
    "arrays": {
      "path_siblings": 20,
      "path_bits": 20
    }
  },
  "properties": [
    {
      "id": "value-conservation",
      "description": "A valid spend must prove amount and withdraw_amount are 64-bit values, withdraw_amount <= amount, and the new change commitment carries amount - withdraw_amount.",
      "checks": [
        "u64-round-trip-range",
        "withdraw-amount-u64-witness",
        "amount-u64-witness",
        "withdraw-lte-amount",
        "change-is-amount-minus-withdraw",
        "change-commitment-uses-change"
      ]
    },
    {
      "id": "leaf-hash-correctness",
      "description": "The spent leaf and change leaf must bind nullifier, secret, amount, and asset through the shared hash_leaf relation.",
      "checks": [
        "hash-leaf-includes-amount",
        "spent-leaf-uses-amount",
        "computed-root-asserted",
        "nullifier-hash-asserted"
      ]
    },
    {
      "id": "asset-binding",
      "description": "The asset a note is denominated in is a public input bound into both the spent leaf and the change leaf, so a proof generated for one asset cannot be reused to withdraw another and change can never switch a note's asset.",
      "checks": [
        "withdraw-asset-is-public",
        "spent-leaf-uses-amount",
        "change-leaf-binds-asset"
      ]
    }
  ]
}
